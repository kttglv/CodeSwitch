{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "CodeSwitch",
  "version": "0.1.0",
  "identifier": "app.codeswitch.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://127.0.0.1:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "CodeSwitch",
        "width": 1060,
        "height": 800,
        "minWidth": 760,
        "minHeight": 640,
        "backgroundColor": "#f7f8fa"
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' asset: data:; connect-src ipc: http://ipc.localhost; object-src 'none'; base-uri 'none'; frame-src 'none'",
      "devCsp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' asset: data:; connect-src ipc: http://ipc.localhost http://127.0.0.1:1420 ws://127.0.0.1:1420; object-src 'none'; base-uri 'none'; frame-src 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Utility",
    "shortDescription": "English and Russian, without the wrong keyboard layout.",
    "longDescription": "CodeSwitch corrects words typed using the wrong English or Russian keyboard layout. Detection runs offline and never logs or uploads typed text.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "../resources/wordfreq/": "licenses/wordfreq/",
      "../LICENSE": "licenses/LICENSE",
      "../THIRD_PARTY_NOTICES.md": "licenses/THIRD_PARTY_NOTICES.md"
    },
    "macOS": {
      "minimumSystemVersion": "13.0",
      "hardenedRuntime": true
    },
    "windows": {
      "bundleVCRuntime": true,
      "nsis": {
        "installMode": "currentUser",
        "displayLanguageSelector": false
      },
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDEyMDEyMzFEREIxRkU1NEMKUldSTTVSL2JIU01CRWhWbnUrUGtQdXVjSmd2UHVFQTNLL2V6UGVqcm8yM1M4aEh6SGhtb0RHWlYK",
      "requireSignedVersion": true,
      "endpoints": [
        "https://github.com/kttglv/CodeSwitch/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
