    "check:release": "python3 scripts/check_release.py"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.10.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.10.0",
    "typescript": "~5.9.3",
    "vite": "^7.1.12"
  }
}
